# TikTok Guard - copy this file to .env and fill it in. NEVER commit the real .env.

# AI replies (free key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-goes-here

# Telegram bot (create one with @BotFather) and the chat that may control it
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-goes-here
TELEGRAM_CHAT_ID=

# The brand profile to watch
BRAND_NAME=Example Store
TARGET_PROFILE_URL=https://www.tiktok.com/@examplebrand

# Behaviour
POLL_INTERVAL_SECONDS=120
MAX_COMMENTS_PER_POLL=20
POSTING_ENABLED=false

# Browser engine (see README: the engine module is not part of this repository)
BFP_BACKEND=patched
BFP_PROFILE_NAME=brand-main
