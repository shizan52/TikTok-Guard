# Settings that ship INSIDE TikTok Guard.exe. They are only defaults: the person's own file
# (%LOCALAPPDATA%\TikTok Guard\.env) and real environment variables win over everything here.
# NO secrets belong in this file - the client enters their own AI key in the app (AI page).
BRAND_NAME=Example Store
TARGET_PROFILE_URL=https://www.tiktok.com/@examplebrand

# the engine that was proven against the real site: the person's own Edge / Chrome / Brave, driven over its debugging port
BFP_BACKEND=patched
BFP_HEADLESS=true
POSTING_ENABLED=true
